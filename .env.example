# Z-Library MCP Server Environment Configuration
# Copy this file to .env and fill in your credentials

# Required only for Z-Library operations (LibGen needs no account): credentials
ZLIBRARY_EMAIL=your@email.com
ZLIBRARY_PASSWORD=your_password_here

# Optional: Custom Z-Library mirror URL
# ZLIBRARY_MIRROR=https://your-mirror.example

# Optional: Anna's Archive API key (from donation)
# Get your key at: https://annas-archive.li/donate
ANNAS_SECRET_KEY=your_secret_key_here

# Optional: Anna's Archive mirror (if main domain is down)
# ANNAS_BASE_URL=https://annas-archive.li

# Optional: LibGen mirror extension (li, bz, gs, etc.)
# LIBGEN_MIRROR=li

# Optional: Retry configuration
# RETRY_MAX_RETRIES=3
# RETRY_INITIAL_DELAY=1000
# RETRY_MAX_DELAY=30000

# Optional: Circuit breaker configuration
# CIRCUIT_BREAKER_THRESHOLD=5
# CIRCUIT_BREAKER_TIMEOUT=60000

# Optional: Whole alternative-source / LibGen mirror walk deadline, in seconds.
# Shared across mirrors, not reset for each attempt; clamped below the owning
# PYTHON_BRIDGE_TIMEOUT or PYTHON_BRIDGE_LONG_TIMEOUT (both milliseconds).
# Unattempted mirrors report walk_budget_exhausted, not a host timeout.
# BOOK_SOURCE_WALK_BUDGET=165
# BOOK_SOURCE_TOTAL_TIMEOUT=45
# BOOK_SOURCE_PREFLIGHT=true
# Aggregate DNS + TCP probe budget, shared across all resolved addresses (seconds).
# Skipped when a proxy applies; BOOK_SOURCE_PREFLIGHT=false disables the probe.
# BOOK_SOURCE_PREFLIGHT_TIMEOUT=5
# Extra Range requests that resume a dropped source transfer within one call,
# inside the same download deadline (0 disables; at most 10).
# BOOK_SOURCE_DOWNLOAD_RESUME_ATTEMPTS=2
